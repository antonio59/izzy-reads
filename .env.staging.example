# Staging Environment Configuration
# Copy this file to .env.staging and fill in the actual values

# Convex Configuration
# Staging URL will be generated when deploying with preview key
VITE_CONVEX_URL=your-staging-convex-url-here

# Giphy API Key (same as development)
# Get your API key at: https://developers.giphy.com/
VITE_GIPHY_API_KEY=your-giphy-api-key-here

# Staging-specific settings
NODE_ENV=staging
VITE_APP_NAME=Izzy Reads - Staging
VITE_APP_URL=https://izzy.antoniosmith.xyz

# Note: Never commit your actual .env.staging file to Git!
# This file should be used as a template and the actual .env.staging
# should be added to .gitignore and configured in Coolify.