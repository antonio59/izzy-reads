{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "izzys-bookshelf",
  "compatibility_date": "2026-09-01",
  // Cloudflare Workers (static assets): Worker runs first so it can
  // intercept social crawlers, then falls through to dist/ with SPA handling.
  // NOTE: do not add pages_build_output_dir here — wrangler would treat the
  // project as Pages and reject `wrangler deploy` on Workers Builds.
  "main": "workers/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "STATIC_ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
}
