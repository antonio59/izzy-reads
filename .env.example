# Convex Configuration
# Get your Convex URL by running: bunx convex dev
VITE_CONVEX_URL=your-convex-deployment-url-here

# Giphy API Key
# Get your API key at: https://developers.giphy.com/
VITE_GIPHY_API_KEY=your-giphy-api-key-here

# Note: Never commit your actual .env.local file to Git!
# The .gitignore file should exclude all .env files with real values.
