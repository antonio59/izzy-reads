# Production Environment Configuration
# These values are set via your hosting provider's environment variable settings

# Convex Configuration
VITE_CONVEX_URL=your-production-convex-url

# Giphy API Key (optional)
# Get your API key at: https://developers.giphy.com/
VITE_GIPHY_API_KEY=your-giphy-api-key-here

# Production-specific settings
NODE_ENV=production

# Note: Environment variables are configured in your hosting provider dashboard
