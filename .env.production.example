# Production Environment Configuration
# Copy this file to .env.production and fill in the actual values

# Convex Configuration
# Your production deployment URL
VITE_CONVEX_URL=https://loyal-vulture-39.convex.cloud

# Giphy API Key (same as development)
# Get your API key at: https://developers.giphy.com/
VITE_GIPHY_API_KEY=your-giphy-api-key-here

# Production-specific settings
NODE_ENV=production
VITE_APP_NAME=Izzy Reads
VITE_APP_URL=https://izzysbookshelf.com

# Note: Never commit your actual .env.production file to Git!
