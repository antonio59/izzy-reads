# Production Environment Configuration
# Set these in Cloudflare → izzy-reads Worker → Settings → Variables and Secrets.
# VITE_* vars are baked into the bundle at build time — trigger a rebuild after changing.

# Convex Configuration — PRODUCTION deployment URL (not the dev one in .env.local!)
VITE_CONVEX_URL=https://loyal-vulture-39.convex.cloud

# Giphy API Key (optional)
# Get your API key at: https://developers.giphy.com/
VITE_GIPHY_API_KEY=your-giphy-api-key-here

# Build environment hints for Cloudflare Workers Builds
NODE_VERSION=22
PNPM_VERSION=11.1.1
